  "proposals": [
    {
      "id": "stop-host",
      "action_type": "host.stop",
      "target_id": "host-a",
      "parameters": {},
      "rationale": "Evaluate a broad shutdown proposed in response to the alert.",
      "expected_effect": "A shared host shutdown would affect both tenants.",
      "assumptions": [
        "All resources are synthetic fixture records."
      ],
      "evidence_refs": [
        "evidence-001"
      ],
      "phase": "initial"
    },
    {
      "id": "suspend-identity",
      "action_type": "identity.suspend",
      "target_id": "identity-a",
      "parameters": {},
      "rationale": "Contain the simulated console activity by suspending the identity associated with the flagged session.",
      "expected_effect": "All simulated sessions under the identity lose access.",
      "assumptions": [
        "All resources are synthetic fixture records."
      ],
      "evidence_refs": [
        "evidence-002"
      ],
      "phase": "initial"
    },
    {
      "id": "suspend-session",
      "action_type": "session.suspend",
      "target_id": "session-a",
      "parameters": {},
      "rationale": "Suspend the flagged console session after reviewing the simulator alert.",
      "expected_effect": "The simulated session loses its VM permission.",
      "assumptions": [
        "All resources are synthetic fixture records."
      ],
      "evidence_refs": [
        "evidence-001"
      ],
      "phase": "alternative"
    }
  ],
  "policies": [
    {
      "id": "synthetic-response-policy",
      "version": "1",
      "rules": [
        {
          "priority": 100,
          "when": {
            "eq": [
              "shared",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_SHARED_RESOURCE"
        },
        {
          "priority": 90,
          "when": {
            "eq": [
              "critical_shared",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_CRITICAL_SHARED_DEPENDENCY"
        },
        {
          "priority": 80,
          "when": {
            "eq": [
              "cross_tenant",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_CROSS_TENANT"
        },
        {
          "priority": 75,
          "when": {
            "eq": [
              "destructive",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_DESTRUCTIVE_ACTION"
        },
        {
          "priority": 70,
          "when": {
            "eq": [
              "unknown",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_UNKNOWN_ACTION"
        },
        {
          "priority": 60,
          "when": {
            "eq": [
              "evidence_ok",
              false
            ]
          },
          "result": "HOLD",
          "reason": "HOLD_EVIDENCE"
        },
        {
          "priority": 50,
          "when": {
            "eq": [
              "sensitive",
              true
            ]
          },
          "result": "REQUIRE_APPROVAL",
          "reason": "REQUIRE_APPROVAL_SENSITIVE"
        },
        {
          "priority": 40,
          "when": {
            "eq": [
              "limited",
              true
            ]
          },
          "result": "ALLOW",
          "reason": "ALLOW_LIMITED_RESPONSE"
        },
        {
          "priority": 0,
          "when": {
            "eq": [
              "unknown",
              false
            ]
          },
          "result": "DENY",
          "reason": "DENY_DEFAULT"
        }
      ]
    }
  ],
