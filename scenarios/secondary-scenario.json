    "source": "service-b",
    "target": "vm-a",
    "type": "depends_on",
    "relation": "depends_on",
    "criticality": "standard",
    "metadata": {}
  },
  "events": [
    {
      "id": "observation-001",
      "event_type": "observation_started",
      "actor_id": "synthetic-monitor",
      "target_id": "tenant-a",
      "outcome": "observed",
      "payload": {
        "detail": "Synthetic incident replay started."
      }
    },
    {
      "id": "evidence-001",
      "event_type": "alert_observed",
      "actor_id": "synthetic-monitor",
      "target_id": "vm-a",
      "outcome": "observed",
      "payload": {
        "detail": "The simulator flagged an overdue maintenance window."
      }
    },
    {
      "id": "evidence-002",
      "event_type": "evidence_observed",
      "actor_id": "synthetic-inventory",
      "target_id": "vm-a",
      "outcome": "observed",
      "payload": {
        "detail": "The fixture records an authorized snapshot on the incident VM and identifies dependencies."
      },
      "permission_check": {
        "session_id": "session-a",
        "action": "vm.snapshot",
        "target_id": "vm-a",
        "mutate": true
      }
    },
    {
      "id": "evidence-003",
      "event_type": "permission_observed",
      "actor_id": "session-a",
      "target_id": "vm-a",
      "outcome": "observed",
      "payload": {
        "detail": "The fixture checks an operation absent from the session grants."
      },
      "permission_check": {
        "session_id": "session-a",
        "action": "vm.start",
        "target_id": "vm-a"
      }
    }
  ],
  "proposals": [
    {
      "id": "snapshot-vm",
      "action_type": "vm.snapshot",
      "target_id": "vm-a",
      "parameters": {},
      "rationale": "Preserve a simulator snapshot before making changes.",
      "expected_effect": "Records one snapshot for the reporting VM.",
      "assumptions": [
        "All resources are synthetic fixture records."
      ],
      "evidence_refs": [
        "evidence-001"
      ],
      "phase": "initial"
    },
    {
      "id": "stop-vm",
      "action_type": "vm.stop",
      "target_id": "vm-a",
      "parameters": {},
      "rationale": "Evaluate stopping the VM for maintenance.",
      "expected_effect": "The simulated VM stops only after approval.",
      "assumptions": [
        "All resources are synthetic fixture records."
      ],
      "evidence_refs": [
        "evidence-002"
      ],
      "phase": "initial"
    },
    {
      "id": "suspend-session",
      "action_type": "session.suspend",
      "target_id": "session-a",
      "parameters": {},
      "rationale": "End the maintenance console session when review is complete.",
      "expected_effect": "The maintenance console session loses its simulated VM access.",
      "assumptions": [
        "All resources are synthetic fixture records."
      ],
      "evidence_refs": [
        "evidence-001"
      ],
      "phase": "alternative"
    }
  ],
  "policies": [
    {
      "id": "synthetic-response-policy",
      "version": "1",
      "rules": [
        {
          "priority": 100,
          "when": {
            "eq": [
              "shared",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_SHARED_RESOURCE"
        },
        {
          "priority": 90,
          "when": {
            "eq": [
              "critical_shared",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_CRITICAL_SHARED_DEPENDENCY"
        },
        {
          "priority": 80,
          "when": {
            "eq": [
              "cross_tenant",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_CROSS_TENANT"
        },
        {
          "priority": 75,
          "when": {
            "eq": [
              "destructive",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_DESTRUCTIVE_ACTION"
        },
        {
          "priority": 70,
          "when": {
            "eq": [
              "unknown",
              true
            ]
          },
          "result": "DENY",
          "reason": "DENY_UNKNOWN_ACTION"
        },
        {
          "priority": 60,
          "when": {
            "eq": [
              "evidence_ok",
              false
            ]
          },
          "result": "HOLD",
          "reason": "HOLD_EVIDENCE"
        },
        {
          "priority": 50,
          "when": {
            "eq": [
              "sensitive",
              true
            ]
          },
          "result": "REQUIRE_APPROVAL",
          "reason": "REQUIRE_APPROVAL_SENSITIVE",
          "approver_role": "incident_owner"
        },
        {
          "priority": 40,
          "when": {
            "eq": [
              "limited",
              true
            ]
          },
          "result": "ALLOW",
          "reason": "ALLOW_LIMITED_RESPONSE"
        },
        {
          "priority": 0,
          "when": {
            "eq": [
              "unknown",
              false
            ]
          },
          "result": "DENY",
          "reason": "DENY_DEFAULT"
        }
      ]
    }
  ],
